xquery version "3.1";

(:~
 : Each index function over the shapes a path can have, and the kinds of node it can be given. The suites run this file
 : with and without the optimizer against one expected answer, so the two have to agree and be right. An answer is the
 : sorted @n of the nodes returned, or of an attribute's parent, then # and how many nodes there were, since some nodes
 : have no @n. See the other path-shapes.xqm files.
 :
 : Generated by org.exist.test.pathshapes.PathShapes from the matrix in this module's PathShapesTest: edit the matrix,
 : then run PathShapesTest with -Dpath-shapes.write=true.
 :)
module namespace ps="http://exist-db.org/xquery/test/path-shapes/lucene";

declare namespace test="http://exist-db.org/xquery/xqsuite";
declare namespace stats="http://exist-db.org/xquery/profiling";
declare namespace h="http://www.w3.org/1999/xhtml";

declare variable $ps:COLLECTION_NAME := "test-path-shapes-lucene";
declare variable $ps:COLLECTION := "/db/" || $ps:COLLECTION_NAME;
declare variable $ps:CONF := "/db/system/config/db/" || $ps:COLLECTION_NAME;

declare variable $ps:XCONF :=
    <collection xmlns="http://exist-db.org/collection-config/1.0" xmlns:h="http://www.w3.org/1999/xhtml">
        <index>
            <lucene><text qname="item"><field name="ps-title" expression="*:t"/><vector-field name="ps-vector" expression="*:embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="other"><field name="ps-title" expression="*:t"/><vector-field name="ps-vector" expression="*:embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="sec"><field name="ps-title" expression="*:t"/><vector-field name="ps-vector" expression="*:embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="part"><field name="ps-title" expression="*:t"/><vector-field name="ps-vector" expression="*:embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="h:body"><field name="ps-title" expression="*:t"/><vector-field name="ps-vector" expression="*:embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="t"/><text qname="sub"><field name="ps-sub-title" expression="st"/><vector-field name="ps-sub-vector" expression="embedding" dimension="3" similarity="cosine" encoding="text"/></text><text qname="@a"><field name="ps-title" expression="."/></text><text qname="@v"><vector-field name="ps-attribute-vector" expression="." dimension="3" similarity="cosine" encoding="text"/></text></lucene>
        </index>
    </collection>;

(: the term is in the first 3 of 10 :)
declare function ps:term($i) {
    <t xmlns="">{if ($i <= 3) then "hit" else "miss"}</t>
};

(: an element below item with its own field and vector :)
declare function ps:sub($i) {
    <sub n="s{$i}"><st>{if ($i <= 3) then "hit" else "miss"}</st><embedding>{"1 " || $i div 10 || " 0"}</embedding></sub>
};

(: the vector moves away from the query as $seed grows :)
declare function ps:vector($seed) {
    <embedding xmlns="">{"1 " || $seed div 10 || " 0"}</embedding>
};

declare
    %test:setUp
function ps:setUp() {
    xmldb:create-collection("/db/system", "config"),
    xmldb:create-collection("/db/system/config", "db"),
    xmldb:create-collection("/db/system/config/db", $ps:COLLECTION_NAME),
    xmldb:store($ps:CONF, "collection.xconf", $ps:XCONF),
    xmldb:create-collection("/db", $ps:COLLECTION_NAME),
    for $c in ("flat", "ns", "nest", "rootnest", "plain") return xmldb:create-collection($ps:COLLECTION, $c),
    for $i in 1 to 10
    return (
        xmldb:store($ps:COLLECTION || "/flat", "d" || $i || ".xml",
            <wrap><!--c-->{processing-instruction pi {"x"}}<item n="{$i}" a="{ps:term($i)}" v="1 {$i div 10} 0">{ps:term($i), ps:vector($i), ps:sub($i)}</item><other n="o{$i}">{ps:term($i), ps:vector($i + 0.5)}</other></wrap>),
        xmldb:store($ps:COLLECTION || "/ns", "h" || $i || ".xml",
            <html xmlns="http://www.w3.org/1999/xhtml"><head/><body n="{$i}">{ps:term($i), ps:vector($i)}</body></html>),
        (: the term is only in the nested element; the outer elements' vectors are far, in the opposite order :)
        xmldb:store($ps:COLLECTION || "/nest", "n" || $i || ".xml",
            <root><sec n="t{$i}">{ps:term(10), ps:vector(21 - $i)}<sec n="c{$i}">{ps:term($i), ps:vector($i)}</sec></sec></root>),
        xmldb:store($ps:COLLECTION || "/rootnest", "r" || $i || ".xml",
            <part n="t{$i}">{ps:term(10), ps:vector(21 - $i)}<part n="c{$i}">{ps:term($i), ps:vector($i)}</part></part>),
        (: no configuration indexes doc or u :)
        xmldb:store($ps:COLLECTION || "/plain", "p" || $i || ".xml",
            <doc><u n="u{$i}">{if ($i <= 3) then "hit" else "miss"}</u></doc>)
    )
};

declare
    %test:tearDown
function ps:tearDown() {
    xmldb:remove($ps:COLLECTION),
    xmldb:remove($ps:CONF)
};

declare function ps:typed($nodes as element()*) as element()* {
    $nodes
};

declare function ps:answer($nodes) {
    string-join((sort(($nodes/@n, $nodes[self::attribute()]/../@n)/string()), "#" || count($nodes)), " ")
};

(: === ft:query === :)

(: Named steps :)
declare %test:assertEquals("1 2 3 #3") function ps:query--desc() { ps:answer(collection($ps:COLLECTION || "/flat")//item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--desc-after-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap//item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--after-wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/*/item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--element-test() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element(item)[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--dos() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/descendant-or-self::item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--self() { ps:answer(collection($ps:COLLECTION || "/flat")//item/self::item[ft:query(., "hit")]) };

(: Wildcard and kind tests on the step :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:query--wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/*[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 s1 s2 s3 #15") function ps:query--wildcard-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//*[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:query--node() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/node()[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 s1 s2 s3 #15") function ps:query--node-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//node()[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:query--element() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element()[ft:query(., "hit")]) };

(: Another element of the file :)
declare %test:assertEquals("o1 o2 o3 #3") function ps:query--other-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/other[ft:query(., "hit")]) };
declare %test:assertEquals("o1 o2 o3 #3") function ps:query--other-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//other[ft:query(., "hit")]) };

(: Namespaces :)
declare %test:assertEquals("1 2 3 #3") function ps:query--ns-child() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:body[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--ns-wildcard() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:*[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--any-ns() { ps:answer(collection($ps:COLLECTION || "/ns")/*:html/*:body[ft:query(., "hit")]) };

(: Unions, parentheses and variables :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:query--union() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item|other)[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--paren-step() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item)[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--paren-path() { ps:answer((collection($ps:COLLECTION || "/flat")/wrap/item)[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[ft:query(., "hit")])) };
declare %test:assertEquals("2 3 #2") function ps:query--two-filters() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[@n > 1][ft:query(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:query--typed-argument() { ps:answer(ps:typed(collection($ps:COLLECTION || "/flat")/wrap/item[ft:query(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:query--typed-variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return ps:typed($i[ft:query(., "hit")]))) };

(: Reverse and sibling axes :)
declare %test:assertEquals("1 2 3 #3") function ps:query--parent() { ps:answer(collection($ps:COLLECTION || "/flat")//t/parent::item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--ancestor() { ps:answer(collection($ps:COLLECTION || "/flat")//t/ancestor::item[ft:query(., "hit")]) };
