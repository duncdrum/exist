declare %test:assertEquals("#3") function ps:query--doc-root() { ps:answer((collection($ps:COLLECTION || "/flat")/wrap/root())[ft:query(., "hit")]) };
declare %test:assertEquals("#3") function ps:query--doc-root-step() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/root()[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--from-doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d/wrap/item[ft:query(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:query--desc-from-doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d//item[ft:query(., "hit")])) };

