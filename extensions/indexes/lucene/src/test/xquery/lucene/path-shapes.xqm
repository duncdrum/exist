declare %test:assertEquals("t1 t2 t3 #3") function ps:query--nested-first() { ps:answer(collection($ps:COLLECTION || "/rootnest")/part[ft:query(., "hit")]) };

(: Other predicates and narrower input :)
declare %test:assertEquals("2 3 #2") function ps:query--pred-before() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[@n > 1][ft:query(., "hit")]) };
declare %test:assertEquals("2 3 #2") function ps:query--pred-after() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[ft:query(., "hit")][@n > 1]) };
declare %test:assertEquals("3 #1") function ps:query--narrowed() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) > 2]/item[ft:query(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:query--in-predicate() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item[ft:query(., "hit")]]/item) };
declare %test:assertEquals("1 2 #2") function ps:query--for() { ps:answer((for $w in collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) <= 2] return $w/item[ft:query(., "hit")])) };

(: Documents as candidates :)
declare %test:assertEquals("#3") function ps:query--doc-filter() { ps:answer(collection($ps:COLLECTION || "/flat")[ft:query(., "hit")]) };
declare %test:assertEquals("#3") function ps:query--doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d[ft:query(., "hit")])) };
