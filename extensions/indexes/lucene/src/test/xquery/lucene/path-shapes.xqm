declare %test:assertEquals("1 2 3 #3") function ps:query--preceding-sibling() { ps:answer(collection($ps:COLLECTION || "/flat")//other/preceding-sibling::item[ft:query(., "hit")]) };

(: Nested elements of one name :)
declare %test:assertEquals("t1 t2 t3 #3") function ps:query--nested-child() { ps:answer(collection($ps:COLLECTION || "/nest")/root/sec[ft:query(., "hit")]) };
declare %test:assertEquals("c1 c2 c3 t1 t2 t3 #6") function ps:query--nested-desc() { ps:answer(collection($ps:COLLECTION || "/nest")/root//sec[ft:query(., "hit")]) };
