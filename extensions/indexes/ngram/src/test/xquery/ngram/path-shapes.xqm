declare %test:assertEquals("#1") function ps:ngram--doc-one() { ps:answer(doc($ps:COLLECTION || "/flat/d1.xml")[ngram:contains(., "hit")]) };
declare %test:assertEquals("#3") function ps:ngram--doc-root() { ps:answer((collection($ps:COLLECTION || "/flat")/wrap/root())[ngram:contains(., "hit")]) };
declare %test:assertEquals("#3") function ps:ngram--doc-root-step() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/root()[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--from-doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d/wrap/item[ngram:contains(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--desc-from-doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d//item[ngram:contains(., "hit")])) };

