xquery version "3.1";

(:~
 : Each index function over the shapes a path can have, and the kinds of node it can be given. The suites run this file
 : with and without the optimizer against one expected answer, so the two have to agree and be right. An answer is the
 : sorted @n of the nodes returned, or of an attribute's parent, then # and how many nodes there were, since some nodes
 : have no @n. See the other path-shapes.xqm files.
 :
 : Generated by org.exist.test.pathshapes.PathShapes from the matrix in this module's PathShapesTest: edit the matrix,
 : then run PathShapesTest with -Dpath-shapes.write=true.
 :)
module namespace ps="http://exist-db.org/xquery/test/path-shapes/ngram";

import module namespace ngram="http://exist-db.org/xquery/ngram";

declare namespace test="http://exist-db.org/xquery/xqsuite";
declare namespace stats="http://exist-db.org/xquery/profiling";
declare namespace h="http://www.w3.org/1999/xhtml";

declare variable $ps:COLLECTION_NAME := "test-path-shapes-ngram";
declare variable $ps:COLLECTION := "/db/" || $ps:COLLECTION_NAME;
declare variable $ps:CONF := "/db/system/config/db/" || $ps:COLLECTION_NAME;

declare variable $ps:XCONF :=
    <collection xmlns="http://exist-db.org/collection-config/1.0" xmlns:h="http://www.w3.org/1999/xhtml">
        <index>
            <ngram qname="item"/><ngram qname="other"/><ngram qname="sec"/><ngram qname="part"/><ngram qname="h:body"/><ngram qname="@a"/><ngram qname="t"/>
        </index>
    </collection>;

(: the term is in the first 3 of 10 :)
declare function ps:term($i) {
    <t xmlns="">{if ($i <= 3) then "hit" else "miss"}</t>
};

declare
    %test:setUp
function ps:setUp() {
    xmldb:create-collection("/db/system", "config"),
    xmldb:create-collection("/db/system/config", "db"),
    xmldb:create-collection("/db/system/config/db", $ps:COLLECTION_NAME),
    xmldb:store($ps:CONF, "collection.xconf", $ps:XCONF),
    xmldb:create-collection("/db", $ps:COLLECTION_NAME),
    for $c in ("flat", "ns", "nest", "rootnest", "plain") return xmldb:create-collection($ps:COLLECTION, $c),
    for $i in 1 to 10
    return (
        xmldb:store($ps:COLLECTION || "/flat", "d" || $i || ".xml",
            <wrap><!--c-->{processing-instruction pi {"x"}}<item n="{$i}" a="{ps:term($i)}" v="1 {$i div 10} 0">{ps:term($i)}</item><other n="o{$i}">{ps:term($i)}</other></wrap>),
        xmldb:store($ps:COLLECTION || "/ns", "h" || $i || ".xml",
            <html xmlns="http://www.w3.org/1999/xhtml"><head/><body n="{$i}">{ps:term($i)}</body></html>),
        (: the term is only in the nested element :)
        xmldb:store($ps:COLLECTION || "/nest", "n" || $i || ".xml",
            <root><sec n="t{$i}">{ps:term(10)}<sec n="c{$i}">{ps:term($i)}</sec></sec></root>),
        xmldb:store($ps:COLLECTION || "/rootnest", "r" || $i || ".xml",
            <part n="t{$i}">{ps:term(10)}<part n="c{$i}">{ps:term($i)}</part></part>),
        (: no configuration indexes doc or u :)
        xmldb:store($ps:COLLECTION || "/plain", "p" || $i || ".xml",
            <doc><u n="u{$i}">{if ($i <= 3) then "hit" else "miss"}</u></doc>)
    )
};

declare
    %test:tearDown
function ps:tearDown() {
    xmldb:remove($ps:COLLECTION),
    xmldb:remove($ps:CONF)
};

declare function ps:typed($nodes as element()*) as element()* {
    $nodes
};

declare function ps:answer($nodes) {
    string-join((sort(($nodes/@n, $nodes[self::attribute()]/../@n)/string()), "#" || count($nodes)), " ")
};

(: === ngram:contains === :)

(: Named steps :)
declare %test:assertEquals("1 2 3 #3") function ps:ngram--desc() { ps:answer(collection($ps:COLLECTION || "/flat")//item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--desc-after-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap//item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--after-wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/*/item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--element-test() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element(item)[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--dos() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/descendant-or-self::item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--self() { ps:answer(collection($ps:COLLECTION || "/flat")//item/self::item[ngram:contains(., "hit")]) };

(: Wildcard and kind tests on the step :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:ngram--wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/*[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #12") function ps:ngram--wildcard-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//*[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:ngram--node() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/node()[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #12") function ps:ngram--node-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//node()[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:ngram--element() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element()[ngram:contains(., "hit")]) };

(: Another element of the file :)
declare %test:assertEquals("o1 o2 o3 #3") function ps:ngram--other-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/other[ngram:contains(., "hit")]) };
declare %test:assertEquals("o1 o2 o3 #3") function ps:ngram--other-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//other[ngram:contains(., "hit")]) };

(: Namespaces :)
declare %test:assertEquals("1 2 3 #3") function ps:ngram--ns-child() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:body[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--ns-wildcard() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:*[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--any-ns() { ps:answer(collection($ps:COLLECTION || "/ns")/*:html/*:body[ngram:contains(., "hit")]) };

(: Unions, parentheses and variables :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:ngram--union() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item|other)[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--paren-step() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item)[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--paren-path() { ps:answer((collection($ps:COLLECTION || "/flat")/wrap/item)[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[ngram:contains(., "hit")])) };
declare %test:assertEquals("2 3 #2") function ps:ngram--two-filters() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[@n > 1][ngram:contains(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--typed-argument() { ps:answer(ps:typed(collection($ps:COLLECTION || "/flat")/wrap/item[ngram:contains(., "hit")])) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--typed-variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return ps:typed($i[ngram:contains(., "hit")]))) };

(: Reverse and sibling axes :)
declare %test:assertEquals("1 2 3 #3") function ps:ngram--parent() { ps:answer(collection($ps:COLLECTION || "/flat")//t/parent::item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--ancestor() { ps:answer(collection($ps:COLLECTION || "/flat")//t/ancestor::item[ngram:contains(., "hit")]) };
declare %test:assertEquals("o1 o2 o3 #3") function ps:ngram--following-sibling() { ps:answer(collection($ps:COLLECTION || "/flat")//item/following-sibling::other[ngram:contains(., "hit")]) };
