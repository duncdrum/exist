(: Nested elements of one name :)
declare %test:assertEquals("t1 t2 t3 #3") function ps:ngram--nested-child() { ps:answer(collection($ps:COLLECTION || "/nest")/root/sec[ngram:contains(., "hit")]) };
declare %test:assertEquals("c1 c2 c3 t1 t2 t3 #6") function ps:ngram--nested-desc() { ps:answer(collection($ps:COLLECTION || "/nest")/root//sec[ngram:contains(., "hit")]) };
declare %test:assertEquals("c1 c2 c3 t1 t2 t3 #6") function ps:ngram--nested-any() { ps:answer(collection($ps:COLLECTION || "/nest")//sec[ngram:contains(., "hit")]) };
declare %test:assertEquals("t1 t2 t3 #3") function ps:ngram--nested-first() { ps:answer(collection($ps:COLLECTION || "/rootnest")/part[ngram:contains(., "hit")]) };

(: Other predicates and narrower input :)
declare %test:assertEquals("2 3 #2") function ps:ngram--pred-before() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[@n > 1][ngram:contains(., "hit")]) };
declare %test:assertEquals("2 3 #2") function ps:ngram--pred-after() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[ngram:contains(., "hit")][@n > 1]) };
declare %test:assertEquals("3 #1") function ps:ngram--narrowed() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) > 2]/item[ngram:contains(., "hit")]) };
declare %test:assertEquals("1 2 3 #3") function ps:ngram--in-predicate() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item[ngram:contains(., "hit")]]/item) };
declare %test:assertEquals("1 2 #2") function ps:ngram--for() { ps:answer((for $w in collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) <= 2] return $w/item[ngram:contains(., "hit")])) };

(: Documents as candidates :)
declare %test:assertEquals("#3") function ps:ngram--doc-filter() { ps:answer(collection($ps:COLLECTION || "/flat")[ngram:contains(., "hit")]) };
declare %test:assertEquals("#3") function ps:ngram--doc-variable() { ps:answer((let $d := collection($ps:COLLECTION || "/flat") return $d[ngram:contains(., "hit")])) };
