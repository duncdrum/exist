xquery version "3.1";

(:~
 : Each index function over the shapes a path can have, and the kinds of node it can be given. The suites run this file
 : with and without the optimizer against one expected answer, so the two have to agree and be right. An answer is the
 : sorted @n of the nodes returned, or of an attribute's parent, then # and how many nodes there were, since some nodes
 : have no @n. See the other path-shapes.xqm files.
 :
 : Generated by org.exist.test.pathshapes.PathShapes from the matrix in this module's PathShapesTest: edit the matrix,
 : then run PathShapesTest with -Dpath-shapes.write=true.
 :)
module namespace ps="http://exist-db.org/xquery/test/path-shapes/noindex";

declare namespace test="http://exist-db.org/xquery/xqsuite";
declare namespace stats="http://exist-db.org/xquery/profiling";
declare namespace h="http://www.w3.org/1999/xhtml";

declare variable $ps:COLLECTION_NAME := "test-path-shapes-noindex";
declare variable $ps:COLLECTION := "/db/" || $ps:COLLECTION_NAME;
declare variable $ps:CONF := "/db/system/config/db/" || $ps:COLLECTION_NAME;

declare variable $ps:XCONF :=
    <collection xmlns="http://exist-db.org/collection-config/1.0" xmlns:h="http://www.w3.org/1999/xhtml">
        <index>
            
        </index>
    </collection>;

(: the term is in the first 3 of 10 :)
declare function ps:term($i) {
    <t xmlns="">{if ($i <= 3) then "hit" else "miss"}</t>
};

declare
    %test:setUp
function ps:setUp() {
    xmldb:create-collection("/db/system", "config"),
    xmldb:create-collection("/db/system/config", "db"),
    xmldb:create-collection("/db/system/config/db", $ps:COLLECTION_NAME),
    xmldb:store($ps:CONF, "collection.xconf", $ps:XCONF),
    xmldb:create-collection("/db", $ps:COLLECTION_NAME),
    for $c in ("flat", "ns", "nest", "rootnest", "plain") return xmldb:create-collection($ps:COLLECTION, $c),
    for $i in 1 to 10
    return (
        xmldb:store($ps:COLLECTION || "/flat", "d" || $i || ".xml",
            <wrap><!--c-->{processing-instruction pi {"x"}}<item n="{$i}" a="{ps:term($i)}" v="1 {$i div 10} 0">{ps:term($i)}</item><other n="o{$i}">{ps:term($i)}</other></wrap>),
        xmldb:store($ps:COLLECTION || "/ns", "h" || $i || ".xml",
            <html xmlns="http://www.w3.org/1999/xhtml"><head/><body n="{$i}">{ps:term($i)}</body></html>),
        (: the term is only in the nested element :)
        xmldb:store($ps:COLLECTION || "/nest", "n" || $i || ".xml",
            <root><sec n="t{$i}">{ps:term(10)}<sec n="c{$i}">{ps:term($i)}</sec></sec></root>),
        xmldb:store($ps:COLLECTION || "/rootnest", "r" || $i || ".xml",
            <part n="t{$i}">{ps:term(10)}<part n="c{$i}">{ps:term($i)}</part></part>),
        (: no configuration indexes doc or u :)
        xmldb:store($ps:COLLECTION || "/plain", "p" || $i || ".xml",
            <doc><u n="u{$i}">{if ($i <= 3) then "hit" else "miss"}</u></doc>)
    )
};

declare
    %test:tearDown
function ps:tearDown() {
    xmldb:remove($ps:COLLECTION),
    xmldb:remove($ps:CONF)
};

declare function ps:typed($nodes as element()*) as element()* {
    $nodes
};

declare function ps:answer($nodes) {
    string-join((sort(($nodes/@n, $nodes[self::attribute()]/../@n)/string()), "#" || count($nodes)), " ")
};

(: === A range comparison === :)

(: Named steps :)
declare %test:assertEquals("1 2 3 #3") function ps:eq--desc() { ps:answer(collection($ps:COLLECTION || "/flat")//item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--desc-after-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap//item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--after-wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/*/item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--element-test() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element(item)[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--dos() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/descendant-or-self::item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--self() { ps:answer(collection($ps:COLLECTION || "/flat")//item/self::item[. = "hit"]) };

(: Wildcard and kind tests on the step :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:eq--wildcard() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/*[. = "hit"]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #12") function ps:eq--wildcard-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//*[. = "hit"]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:eq--node() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/node()[. = "hit"]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #18") function ps:eq--node-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//node()[. = "hit"]) };
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:eq--element() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/element()[. = "hit"]) };

(: Another element of the file :)
declare %test:assertEquals("o1 o2 o3 #3") function ps:eq--other-child() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/other[. = "hit"]) };
declare %test:assertEquals("o1 o2 o3 #3") function ps:eq--other-desc() { ps:answer(collection($ps:COLLECTION || "/flat")//other[. = "hit"]) };

(: Namespaces :)
declare %test:assertEquals("1 2 3 #3") function ps:eq--ns-child() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:body[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--ns-wildcard() { ps:answer(collection($ps:COLLECTION || "/ns")/h:html/h:*[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--any-ns() { ps:answer(collection($ps:COLLECTION || "/ns")/*:html/*:body[. = "hit"]) };

(: Unions, parentheses and variables :)
declare %test:assertEquals("1 2 3 o1 o2 o3 #6") function ps:eq--union() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item|other)[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--paren-step() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/(item)[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--paren-path() { ps:answer((collection($ps:COLLECTION || "/flat")/wrap/item)[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[. = "hit"])) };
declare %test:assertEquals("2 3 #2") function ps:eq--two-filters() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return $i[@n > 1][. = "hit"])) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--typed-argument() { ps:answer(ps:typed(collection($ps:COLLECTION || "/flat")/wrap/item[. = "hit"])) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--typed-variable() { ps:answer((let $i := collection($ps:COLLECTION || "/flat")/wrap/item return ps:typed($i[. = "hit"]))) };

(: Reverse and sibling axes :)
declare %test:assertEquals("1 2 3 #3") function ps:eq--parent() { ps:answer(collection($ps:COLLECTION || "/flat")//t/parent::item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--ancestor() { ps:answer(collection($ps:COLLECTION || "/flat")//t/ancestor::item[. = "hit"]) };
declare %test:assertEquals("o1 o2 o3 #3") function ps:eq--following-sibling() { ps:answer(collection($ps:COLLECTION || "/flat")//item/following-sibling::other[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--preceding-sibling() { ps:answer(collection($ps:COLLECTION || "/flat")//other/preceding-sibling::item[. = "hit"]) };

(: Nested elements of one name :)
declare %test:assertEquals("#0") function ps:eq--nested-child() { ps:answer(collection($ps:COLLECTION || "/nest")/root/sec[. = "hit"]) };
declare %test:assertEquals("c1 c2 c3 #3") function ps:eq--nested-desc() { ps:answer(collection($ps:COLLECTION || "/nest")/root//sec[. = "hit"]) };
declare %test:assertEquals("c1 c2 c3 #3") function ps:eq--nested-any() { ps:answer(collection($ps:COLLECTION || "/nest")//sec[. = "hit"]) };
declare %test:assertEquals("#0") function ps:eq--nested-first() { ps:answer(collection($ps:COLLECTION || "/rootnest")/part[. = "hit"]) };

(: Other predicates and narrower input :)
declare %test:assertEquals("2 3 #2") function ps:eq--pred-before() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[@n > 1][. = "hit"]) };
declare %test:assertEquals("2 3 #2") function ps:eq--pred-after() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap/item[. = "hit"][@n > 1]) };
declare %test:assertEquals("3 #1") function ps:eq--narrowed() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) > 2]/item[. = "hit"]) };
declare %test:assertEquals("1 2 3 #3") function ps:eq--in-predicate() { ps:answer(collection($ps:COLLECTION || "/flat")/wrap[item[. = "hit"]]/item) };
declare %test:assertEquals("1 2 #2") function ps:eq--for() { ps:answer((for $w in collection($ps:COLLECTION || "/flat")/wrap[item/xs:integer(@n) <= 2] return $w/item[. = "hit"])) };

(: Documents as candidates :)
declare %test:assertEquals("#0") function ps:eq--doc-filter() { ps:answer(collection($ps:COLLECTION || "/flat")[. = "hit"]) };
